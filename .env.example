# Business UPI ID (e.g. paytmqr5i4hko@ptys) — already pre-configured, can also be changed in Admin Panel
BUSINESS_UPI_VPA=paytmqr5i4hko@ptys
BUSINESS_NAME=SwiftGate

# Razorpay Payment Gateway (for instant verified Business UPI QR & auto-webhook settlement)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional: Merchant Phone Notification / SMS Auto-Forwarder Webhook Secret (for 0% fee Business UPI QR)
MERCHANT_WEBHOOK_SECRET=

# Admin Panel Passcode (if empty, first user can claim admin password in-app on first run)
ADMIN_PASSCODE=

# Optional: GitHub Personal Access Token (repo scope) to also auto-update by7484040420-cell/bipin-licenses/licenses.txt
GITHUB_LICENSE_TOKEN=
