<?xml version="1.0" encoding="utf-8"?>
<!-- ===== REPLACE (purani file hatao, ye daalo) =====
     Yaha rakho: app/src/main/res/layout/activity_main.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SWIFTGATE"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Location-based Auto-Accept"
            android:textColor="#9E9E9E"
            android:textSize="13sp"
            android:paddingBottom="20dp" />

        <TextView
            android:id="@+id/statusAccessibility"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:paddingBottom="6dp" />

        <TextView
            android:id="@+id/statusOverlay"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:paddingBottom="14dp" />

        <TextView
            android:id="@+id/tvWarn"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFB74D"
            android:textSize="14sp"
            android:paddingBottom="12dp" />

        <TextView
            android:id="@+id/statusRules"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#B0BEC5"
            android:textSize="13sp"
            android:background="#1E1E1E"
            android:padding="12dp" />

        <!-- ON/OFF | LOCATION | SWIPE ZONE : teeno ek hi line me -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnStartStop"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:maxLines="2"
                android:backgroundTint="#43A047"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="13sp"
                android:text="ON" />

            <Button
                android:id="@+id/btnSetArea"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:maxLines="2"
                android:textStyle="bold"
                android:textSize="13sp"
                android:text="LOCATION" />

            <Button
                android:id="@+id/btnSwipeZone"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:maxLines="2"
                android:textStyle="bold"
                android:textSize="13sp"
                android:text="SWIPE ZONE" />
        </LinearLayout>

        <Button
            android:id="@+id/btnPermissions"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Setup Pura Karein (kuch permission baaki hai)" />

        <!-- Beech me VIDEO ad. Ad aane par hi dikhta hai. -->
        <com.google.android.gms.ads.nativead.NativeAdView
            android:id="@+id/adVideoBox"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:background="#1E1E1E">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#FFB300"
                    android:paddingLeft="6dp"
                    android:paddingRight="6dp"
                    android:text="Ad"
                    android:textColor="#000000"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <com.google.android.gms.ads.nativead.MediaView
                    android:id="@+id/adMedia"
                    android:layout_width="match_parent"
                    android:layout_height="190dp"
                    android:layout_marginTop="6dp" />

                <TextView
                    android:id="@+id/adHeadline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/adCta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" />
            </LinearLayout>
        </com.google.android.gms.ads.nativead.NativeAdView>

        <TextView
            android:id="@+id/tvAdvanced"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="12dp"
            android:gravity="center"
            android:text="Advanced \u25BE"
            android:textColor="#757575"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/advancedBox"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <Button
            android:id="@+id/btnFloatingBubble"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Floating Bubble ON Karein" />

        <TextView
            android:id="@+id/statusRoot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnRootSetup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Root: Auto Permissions" />

        <Button
            android:id="@+id/btnScreenWatch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Screen Watcher ON Karein" />

        </LinearLayout>

    </LinearLayout>
    </ScrollView>

    <!-- Neeche ka banner code se banta hai (ad ID AdIds.kt me) -->
    <FrameLayout
        android:id="@+id/adBannerBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>
