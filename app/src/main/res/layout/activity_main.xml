<?xml version="1.0" encoding="utf-8"?>
<!-- ===== REPLACE (purani file hatao, ye daalo) =====
     Yaha rakho: app/src/main/res/layout/activity_main.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SWIFTGATE"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Location-based Auto-Accept"
            android:textColor="#9E9E9E"
            android:textSize="13sp"
            android:paddingBottom="20dp" />

        <TextView
            android:id="@+id/statusAccessibility"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:paddingBottom="6dp" />

        <TextView
            android:id="@+id/statusOverlay"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:paddingBottom="6dp" />

        <TextView
            android:id="@+id/statusExtraPerms"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:paddingBottom="14dp" />

        <TextView
            android:id="@+id/tvWarn"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFB74D"
            android:textSize="14sp"
            android:paddingBottom="12dp" />

        <TextView
            android:id="@+id/statusRules"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#B0BEC5"
            android:textSize="13sp"
            android:background="#1E1E1E"
            android:padding="12dp" />

        <!-- ON/OFF | LOCATION | SWIPE ZONE : teeno ek hi line me -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnStartStop"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:maxLines="2"
                android:backgroundTint="#43A047"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="13sp"
                android:text="ON" />

            <Button
                android:id="@+id/btnSetArea"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:maxLines="2"
                android:textStyle="bold"
                android:textSize="13sp"
                android:text="LOCATION\n(ACCEPT)" />

            <Button
                android:id="@+id/btnSwipeZone"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingLeft="2dp"
                android:paddingRight="2dp"
                android:maxLines="2"
                android:textStyle="bold"
                android:textSize="13sp"
                android:text="SWIPE ZONE" />
        </LinearLayout>

        <Button
            android:id="@+id/btnPermissions"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="#E65100"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:text="Sabhi Settings ON Karein (Setup Baaki Hai)" />

        <Button
            android:id="@+id/btnFloatingBubble"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textStyle="bold"
            android:text="Floating Bubble: AUTO ON" />

        <Button
            android:id="@+id/btnWhatsappHelp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:backgroundTint="#1D3324"
            android:textColor="#81C784"
            android:text="WhatsApp Help / Support (8383872065)" />

    </LinearLayout>
    </ScrollView>

</LinearLayout>
