<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnTabPickup"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="PICKUP" />

        <Button
            android:id="@+id/btnTabDrop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="DROP" />
    </LinearLayout>

    <EditText
        android:id="@+id/locationSearch"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Location / sector search ya type karein"
        android:textColor="#FFFFFF"
        android:textColorHint="#BDBDBD"
        android:singleLine="true"
        android:inputType="text"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="#2A2A2A"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:id="@+id/pickupFilterBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:background="#1E1E1E"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pickup Filter (KM + Khaas Naam + Niche Location) — sab ek jagah:"
            android:textColor="#81C784"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Location set ho to location se, KM set ho to KM meter se, dono khaali hon to Pickup kahin se bhi aur kitni bhi door se uth sakta hai."
            android:textColor="#B0BEC5"
            android:textSize="11sp" />

        <EditText
            android:id="@+id/etMaxPickupKm"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="6dp"
            android:background="#2A2A2A"
            android:hint="Pickup Max KM (jaise: 2, 3 ya 3.5 — khaali = koi limit nahi)"
            android:inputType="numberDecimal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#9E9E9E"
            android:textSize="13sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnDistOff"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="48dp"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:text="OFF"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnDist05"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="52dp"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:text="0.5km"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnDist06"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="52dp"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:text="0.6km"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnDist1"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="48dp"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:text="1km"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnDist2"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="48dp"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:text="2km"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnDist3"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="48dp"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:text="3km"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnDist5"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginStart="4dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="48dp"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:text="5km"
                    android:textSize="11sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <EditText
            android:id="@+id/pickupKeywords"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#2A2A2A"
            android:gravity="top|start"
            android:hint="Khaas jagah ke naam (jaise: Mote Lala, Gurudwara, Metro)"
            android:inputType="textMultiLine|textCapWords"
            android:maxLines="2"
            android:minHeight="44dp"
            android:padding="10dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#BDBDBD"
            android:textSize="13sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:id="@+id/cityContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <Button
        android:id="@+id/btnResetAll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="SAB LOCATION RESET (sab hata do)" />

    <Button
        android:id="@+id/btnSaveAreas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="SAVE" />
</LinearLayout>
