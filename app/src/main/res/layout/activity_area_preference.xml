<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnTabPickup"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="PICKUP" />

        <Button
            android:id="@+id/btnTabDrop"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="DROP" />
    </LinearLayout>

    <EditText
        android:id="@+id/locationSearch"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Location / sector search ya type karein"
        android:textColor="#FFFFFF"
        android:textColorHint="#BDBDBD"
        android:singleLine="true"
        android:inputType="text"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="#2A2A2A"
        android:layout_marginBottom="8dp" />

    <CheckBox
        android:id="@+id/cbNoPickupRestriction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:text="Pickup khaali rakhein (location band — distance ya sab chalega)" />

    <LinearLayout
        android:id="@+id/pickupDistanceBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="#1E1E1E"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pickup Max Distance (KM) — agar location nahi pata ho to kitne km tak uthana hai:"
            android:textColor="#81C784"
            android:textSize="12sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etMaxPickupKm"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="6dp"
            android:background="#2A2A2A"
            android:hint="Jaise: 0.5, 0.6 ya 2 (khaali = off)"
            android:inputType="numberDecimal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#9E9E9E"
            android:textSize="13sp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnDistOff"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="48dp"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:text="OFF"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnDist05"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="4dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="52dp"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:text="0.5km"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnDist06"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="4dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="52dp"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:text="0.6km"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnDist1"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="4dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="48dp"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:text="1km"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnDist2"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="4dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="48dp"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:text="2km"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnDist3"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="4dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="48dp"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:text="3km"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnDist5"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="4dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="48dp"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:text="5km"
                    android:textSize="11sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <CheckBox
            android:id="@+id/cbAllowMissingKm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Popup par KM na likha ho (jaise ₹41 wala card) to bhi Drop match par uthaye"
            android:textColor="#E0E0E0"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvKeywordHelp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Khaas jagah ke naam (comma se alag). Inme se koi EK bhi pickup me mile to order chalega."
        android:textColor="#FFB74D"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/pickupKeywords"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        android:gravity="top|start"
        android:hint="Jaise: Mote Lala, Gurudwara, Lal Qila, Metro"
        android:textColor="#FFFFFF"
        android:textColorHint="#BDBDBD"
        android:inputType="textMultiLine|textCapWords"
        android:padding="12dp"
        android:background="#2A2A2A"
        android:layout_marginTop="4dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:id="@+id/cityContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <Button
        android:id="@+id/btnResetAll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="SAB LOCATION RESET (sab hata do)" />

    <Button
        android:id="@+id/btnSaveAreas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="SAVE" />
</LinearLayout>
