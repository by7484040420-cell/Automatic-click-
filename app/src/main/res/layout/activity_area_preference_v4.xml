<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#121212" android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
        <Button android:id="@+id/btnTabPickup" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="PICKUP" />
        <Button android:id="@+id/btnTabDrop" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:text="DROP" />
    </LinearLayout>
    <CheckBox android:id="@+id/cbNoPickupRestriction" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:text="Pickup khaali rakhein (koi bhi pickup chalega)" />
    <EditText android:id="@+id/etLocationSearch" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Exact location type/search karein" android:textColor="#FFFFFF" android:textColorHint="#AAAAAA" android:singleLine="true" android:inputType="textCapWords" android:layout_marginTop="6dp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Type karne se list filter hogi; exact location yahin save bhi ho sakti hai." android:textColor="#AAAAAA" android:textSize="12sp" android:paddingTop="4dp" android:paddingBottom="4dp" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp">
        <LinearLayout android:id="@+id/cityContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
    </ScrollView>
    <Button android:id="@+id/btnSaveAreas" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="SAVE" />
</LinearLayout>
